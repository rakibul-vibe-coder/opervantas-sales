# ==============================================
# Multi-Salesman Daily Sales Management System
# Environment Variables Template
# ==============================================
# Copy this file to .env.local and fill in your Supabase credentials

# ==============================================
# SUPABASE CONFIGURATION
# Get these from your Supabase project dashboard:
# Settings > API > Project URL & API Keys
# ==============================================

# Your Supabase Project URL (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase Service Role Key (NEVER expose this in browser)
# Used for server-side admin operations (creating users, bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Application URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Business timezone (do not change unless relocating business)
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Dhaka

# Business day reset hour (24-hour format, 1 = 1:00 AM)
NEXT_PUBLIC_BUSINESS_DAY_RESET_HOUR=1

# ==============================================
# SECURITY CONFIGURATION (Server-side only)
# ==============================================

# Secret for signing internal API tokens (generate with: openssl rand -base64 32)
API_SECRET=your-32-char-random-secret-here

# ==============================================
# OPTIONAL: RATE LIMITING
# ==============================================

# Redis URL for rate limiting (optional, falls back to in-memory)
# REDIS_URL=redis://localhost:6379
